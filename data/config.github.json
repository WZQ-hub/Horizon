{
  "ai": {
    "provider": "openai",
    "model": "gpt-6.1-terra",
    "base_url": "https://api.lingsuan.si/v1",
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": ["zh", "en"],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": { "threshold": 6.5, "topic_dedup": true },
      "tech-blog": { "threshold": 5.0, "topic_dedup": false },
      "finance-news": { "threshold": 7.0, "topic_dedup": true }
    }
  },
  "sources": {
    "github": [
      { "type": "user_events", "username": "karpathy", "enabled": true, "category": "ai-frontier", "profile": "tech-news" },
      { "type": "repo_releases", "owner": "vllm-project", "repo": "vllm", "enabled": true, "category": "ai-frontier", "profile": "tech-news" },
      { "type": "repo_releases", "owner": "sgl-project", "repo": "sglang", "enabled": true, "category": "ai-frontier", "profile": "tech-news" }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 150,
      "category": "ai-frontier",
      "profile": "tech-news"
    },
    "rss": [
      { "name": "BBC World", "url": "https://feeds.bbci.co.uk/news/world/rss.xml", "enabled": true, "category": "world", "profile": "tech-news" },
      { "name": "The Guardian World", "url": "https://www.theguardian.com/world/rss", "enabled": true, "category": "world", "profile": "tech-news" },
      { "name": "Al Jazeera", "url": "https://www.aljazeera.com/xml/rss/all.xml", "enabled": true, "category": "world", "profile": "tech-news" },
      { "name": "NPR World", "url": "https://feeds.npr.org/1004/rss.xml", "enabled": true, "category": "world", "profile": "tech-news" },

      { "name": "BBC China", "url": "https://feeds.bbci.co.uk/news/world/asia/china/rss.xml", "enabled": true, "category": "china-intl", "profile": "tech-news" },
      { "name": "The Guardian China", "url": "https://www.theguardian.com/world/china/rss", "enabled": true, "category": "china-intl", "profile": "tech-news" },
      { "name": "BBC 中文", "url": "https://feeds.bbci.co.uk/zhongwen/simp/rss.xml", "enabled": true, "category": "china-intl", "profile": "tech-news" },
      { "name": "DW 中文", "url": "https://rss.dw.com/rdf/rss-chi-all", "enabled": true, "category": "china-intl", "profile": "tech-news" },

      { "name": "China Daily", "url": "https://www.chinadaily.com.cn/rss/china_rss.xml", "enabled": true, "category": "china-domestic", "profile": "tech-news" },
      { "name": "中国新闻网", "url": "https://www.chinanews.com.cn/rss/scroll-news.xml", "enabled": true, "category": "china-domestic", "profile": "tech-news" },

      { "name": "OpenAI News", "url": "https://openai.com/news/rss.xml", "enabled": true, "category": "ai-frontier", "profile": "tech-news" },
      { "name": "Google DeepMind", "url": "https://deepmind.google/blog/rss.xml", "enabled": true, "category": "ai-frontier", "profile": "tech-news" },
      { "name": "Hugging Face Blog", "url": "https://huggingface.co/blog/feed.xml", "enabled": true, "category": "ai-frontier", "profile": "tech-blog" },
      { "name": "MIT Tech Review AI", "url": "https://www.technologyreview.com/topic/artificial-intelligence/feed", "enabled": true, "category": "ai-frontier", "profile": "tech-news" },
      { "name": "Import AI", "url": "https://importai.substack.com/feed", "enabled": true, "category": "ai-frontier", "profile": "tech-blog" },
      { "name": "Simon Willison", "url": "https://simonwillison.net/atom/everything/", "enabled": true, "category": "ai-frontier", "profile": "tech-news" },
      { "name": "GitHub Trending - Daily", "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml", "enabled": true, "category": "ai-frontier", "profile": "tech-news" }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        { "subreddit": "MachineLearning", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 10, "min_score": 60, "category": "ai-frontier", "profile": "tech-news" },
        { "subreddit": "LocalLLaMA", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 10, "min_score": 60, "category": "ai-frontier", "profile": "tech-news" },
        { "subreddit": "worldnews", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 15, "min_score": 1000, "category": "world", "profile": "tech-news" }
      ],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {
      "enabled": true,
      "channels": [
        { "channel": "zaihuapd", "enabled": true, "fetch_limit": 20, "category": "china-domestic", "profile": "tech-news" }
      ]
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 30,
    "profile_order": ["tech-news", "tech-blog", "finance-news"],
    "category_groups": {
      "world":  { "name": "国际", "limit": 8,  "categories": ["world"] },
      "china":  { "name": "中国", "limit": 10, "categories": ["china-intl", "china-domestic"] },
      "ai":     { "name": "AI 前沿", "limit": 12, "categories": ["ai-frontier"] }
    },
    "default_group": "other",
    "default_group_limit": 3
  },
  "webhook": {
    "enabled": false
  }
}
